#!/usr/bin/env python3
"""PDX Format - CLI formatter for Paradox Interactive script files."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
# pdx_utilities is the shared sibling checkout (../pdx-utilities), not vendored.
_shared = Path(__file__).resolve().parent.parent / "pdx-utilities"
if _shared.is_dir():
    sys.path.insert(1, str(_shared))
from pdx_format.cli import main

main()
